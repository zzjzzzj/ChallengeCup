{
  "protocol_version": "2.0",
  "scenario": "class_incremental",
  "head_policy": "single_expanding_head",
  "purpose": "六种目标类别按固定顺序逐类训练，验证 ER/DER 回放与抗遗忘能力。",
  "class_order": [
    "soldier",
    "small_aircraft",
    "warship",
    "tank",
    "patrol_boat",
    "armored_vehicle"
  ],
  "stages": [
    {
      "stage": 0,
      "name": "base",
      "new_classes": ["soldier"],
      "old_classes": [],
      "all_learned_classes": ["soldier"]
    },
    {
      "stage": 1,
      "name": "increment_1",
      "new_classes": ["small_aircraft"],
      "old_classes": ["soldier"],
      "all_learned_classes": ["soldier", "small_aircraft"]
    },
    {
      "stage": 2,
      "name": "increment_2",
      "new_classes": ["warship"],
      "old_classes": ["soldier", "small_aircraft"],
      "all_learned_classes": ["soldier", "small_aircraft", "warship"]
    },
    {
      "stage": 3,
      "name": "increment_3",
      "new_classes": ["tank"],
      "old_classes": ["soldier", "small_aircraft", "warship"],
      "all_learned_classes": ["soldier", "small_aircraft", "warship", "tank"]
    },
    {
      "stage": 4,
      "name": "increment_4",
      "new_classes": ["patrol_boat"],
      "old_classes": ["soldier", "small_aircraft", "warship", "tank"],
      "all_learned_classes": ["soldier", "small_aircraft", "warship", "tank", "patrol_boat"]
    },
    {
      "stage": 5,
      "name": "increment_5",
      "new_classes": ["armored_vehicle"],
      "old_classes": ["soldier", "small_aircraft", "warship", "tank", "patrol_boat"],
      "all_learned_classes": ["soldier", "small_aircraft", "warship", "tank", "patrol_boat", "armored_vehicle"]
    }
  ],
  "methods": ["ER", "DER"],
  "buffer_sizes": [200, 500],
  "metrics": {
    "new_map": "当前阶段新增类别的 mAP",
    "average_incremental_accuracy": "六阶段已见类别平均性能的均值",
    "average_forgetting": "旧类别历史最佳性能到最终性能的平均下降",
    "backward_transfer": "最终性能相对类别初学阶段性能的平均变化"
  },
  "compliance_warning": "训练数据、缓冲池、暗响应和模型权重必须只保存在本地。"
}
